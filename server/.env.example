# URL de conexión a tu PostgreSQL local
# Estructura: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD?schema=public
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD?schema=public"

# Puerto en el que correrá la API de Express
PORT=

# Clave para firmar las sesiones. Genera una con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Contraseña de las cuentas de ejemplo que crea `npx prisma db seed`
SEED_PASSWORD=

# Base EXCLUSIVA para `npm test`: las pruebas borran todos sus datos.
# Su nombre debe contener "test".
TEST_DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/sixseven_test?schema=public"
